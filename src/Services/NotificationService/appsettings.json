{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "LeaveManagementSystemSecretKeyThatIsAtLeast32Characters",
    "Issuer": "LeaveManagementSystem",
    "Audience": "LeaveManagementClient"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "leave_management_exchange",
    "QueueName": "notification_queue"
  },
  "Consul": {
    "Host": "localhost",
    "Port": 8500,
    "Discovery": {
      "Enabled": true,
      "Register": true,
      "ServiceName": "notification-service",
      "HostName": "localhost",
      "Port": 5004,
      "HealthCheckPath": "/health",
      "HealthCheckInterval": "10s"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5004"
      }
    }
  }
}
