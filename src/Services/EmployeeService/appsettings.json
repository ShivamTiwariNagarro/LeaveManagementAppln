{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "LeaveManagementSystemSecretKeyThatIsAtLeast32Characters",
    "Issuer": "LeaveManagementSystem",
    "Audience": "LeaveManagementClient",
    "ExpirationMinutes": 60
  },
  "Consul": {
    "Host": "localhost",
    "Port": 8500,
    "Discovery": {
      "Enabled": true,
      "Register": true,
      "ServiceName": "employee-service",
      "HostName": "localhost",
      "Port": 5002,
      "HealthCheckPath": "/health",
      "HealthCheckInterval": "10s"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5002"
      }
    }
  }
}
