{
  "_comment": "Ocelot Static Configuration - Uses hardcoded DownstreamHostAndPorts",
  "_usage": "This config is loaded for local development. Docker uses ocelot.docker.json with container hostnames.",
  
  "Routes": [
    {
      "_comment": "Route: POST /api/auth/login - User login (no auth required)",
      "DownstreamPathTemplate": "/api/auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/api/auth/login",
      "UpstreamHttpMethod": [ "Post" ]
    },
    {
      "_comment": "Route: GET /api/auth/validate - Validate JWT token",
      "DownstreamPathTemplate": "/api/auth/validate",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/api/auth/validate",
      "UpstreamHttpMethod": [ "Get" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    },
    {
      "_comment": "Route: GET /api/employees/{employeeId} - Get employee details",
