{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Consul": {
    "Host": "localhost",
    "Port": 8500,
    "Discovery": {
      "Enabled": true,
      "Register": false
    }
  },
  "Jwt": {
    "SecretKey": "LeaveManagementSystemSecretKeyThatIsAtLeast32Characters",
    "Issuer": "LeaveManagementSystem",
    "Audience": "LeaveManagementClient",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Ocelot": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  }
}
